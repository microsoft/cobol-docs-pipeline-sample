{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://org.example.com/schemas/sources.schema.json",
  "title": "Sources configuration",
  "description": "Schema for config/sources.yaml — controls source ingestion, encoding, profiles, and modernization targets.",
  "type": "object",
  "required": ["source_root", "include", "modernization"],
  "additionalProperties": false,
  "properties": {
    "source_root": {
      "type": "string",
      "description": "Absolute path (or relative to repo root) to the folder containing COBOL/JCL sources."
    },
    "include": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Globs relative to source_root to include."
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "encodings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["auto", "utf-8", "cp037", "cp1047", "cp1140", "cp1252", "latin-1"]
      }
    },
    "platform": {
      "type": "string",
      "enum": ["auto", "mainframe", "ibmi"],
      "default": "auto",
      "description": "Default COBOL runtime platform. ibmi covers IBM i (AS/400) ILE COBOL sources."
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["auto", "mainframe", "ibmi"]
      },
      "default": {},
      "description": "Per-file platform overrides keyed by glob relative to source_root."
    },
    "functional_analysis_profile": { "type": "string", "default": "default" },
    "requirements_profile": { "type": "string", "default": "default" },
    "copybook_search_paths": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "pipeline": {
      "type": "object",
      "description": "Pipeline execution model consumed by the orchestrator and scripts/run-pipeline.ps1.",
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "type": "string",
          "enum": ["per-file-loop", "per-phase"],
          "default": "per-file-loop",
          "description": "per-file-loop: run every file-scoped phase end-to-end per file, then workspace phases. per-phase: legacy DAG-wide execution."
        },
        "per_file_parallelism": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of files processed concurrently when execution_mode=per-file-loop. 1 = strict sequential."
        }
      }
    },
    "modernization": {
      "type": "object",
      "required": ["target_languages", "orchestration_target", "db_target"],
      "additionalProperties": false,
      "properties": {
        "target_languages": {
          "type": "array",
          "items": { "type": "string", "enum": ["java", "dotnet"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "orchestration_target": {
          "type": "string",
          "enum": ["spring-batch", "azure-functions", "airflow", "step-functions"]
        },
        "db_target": {
          "type": "string",
          "enum": ["postgres", "sqlserver", "db2", "as-is"]
        }
      }
    }
  }
}
